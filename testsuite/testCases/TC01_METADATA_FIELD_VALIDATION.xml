<?xml version="1.0" encoding="UTF-8"?>
<testcase id="TC01_METADATA_FIELD_VALIDATION"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">

    <metadata>
        <gitb:name>Metadata Field Validation - D Priority Logic</gitb:name>
        <gitb:version>3.0.0</gitb:version>
        <gitb:description>
            Defines metadata validation logic against the D TTL profile.
            The uploaded JSON-LD metadata is sent to the locally deployed
            official SHACL Validator through its GITB SOAP API.
        </gitb:description>
    </metadata>

    <imports>
        <artifact name="energyShapes">Resources/building-energy-shapes_D.ttl</artifact>
        <artifact name="samplePass">Samples/metadata-valid.jsonld</artifact>
        <artifact name="sampleFail">Samples/metadata-invalid.jsonld</artifact>
    </imports>

    <actors engineName="ITB Test Engine" engineDisplayOrder="4">
        <gitb:actor id="Provider" name="Energy Data Provider" role="SUT" displayOrder="0"/>
        <gitb:actor id="Authority" name="City Energy Data Space Authority" role="SIMULATED" displayOrder="1"/>
        <gitb:actor id="Validator" name="ITB Validation Engine" role="SIMULATED" displayOrder="2"/>
    </actors>

    <steps>
        <interact id="userData"
                  desc="Upload building energy metadata for SHACL validation">
            <request name="metadata"
                     desc="Select a JSON-LD metadata file to validate"
                     inputType="UPLOAD"
                     mimeType="application/ld+json"
                     required="true"/>
        </interact>

        <assign to="metadataStatusPriority">"untestable,fail,inapplicable,pass"</assign>
        <assign to="metadataOptionalBlankNormalization">true()</assign>
        <assign to="metadataUploadedFile">$userData{metadata}</assign>
        <assign to="metadataRuleSource">$energyShapes</assign>

        <verify id="validateMetadataWithSoapShaclValidator"
                handler="http://shacl-validator:8080/shacl/soap/energy/validation?wsdl"
                desc="Validate uploaded metadata with the official SHACL Validator SOAP API">
            <input name="contentToValidate">$userData{metadata}</input>
            <input name="contentSyntax">"application/ld+json"</input>
            <input name="validationType">"v1"</input>
        </verify>

        <assign to="metadataPassSample">$samplePass</assign>
        <assign to="metadataPassExpected">"pass"</assign>
        <assign to="metadataPassDecision">"accepted"</assign>
        <assign to="metadataFailSample">$sampleFail</assign>
        <assign to="metadataFailExpected">"fail"</assign>
        <assign to="metadataFailDecision">"rejected"</assign>
        <assign to="metadataInapplicableExpected">"inapplicable"</assign>
        <assign to="metadataInapplicableDecision">"rejected"</assign>
        <assign to="metadataUntestableExpected">"untestable"</assign>
        <assign to="metadataUntestableDecision">"rejected"</assign>
    </steps>

    <output>
        <success>
            <default>"Metadata validation logic is defined: pass is accepted; fail, inapplicable, and untestable are rejected."</default>
        </success>
        <failure>
            <default>"Metadata validation logic definition failed."</default>
        </failure>
    </output>

</testcase>
