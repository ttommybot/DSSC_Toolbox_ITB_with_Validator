<?xml version="1.0" encoding="UTF-8"?>
<testcase id="TC03_LICENSE_POLICY_VALIDATION"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">

    <metadata>
        <gitb:name>License Policy Validation - Priority Logic</gitb:name>
        <gitb:version>3.0.0</gitb:version>
        <gitb:description>
            Defines the license policy validation scenarios against the Authority
            whitelist. The Data Provider uploads full JSON-LD metadata, and the
            license value is treated as extracted from that metadata. The current
            design-only version records the expected status mapping and
            onboarding decision without calling a concrete validator handler.
        </gitb:description>
    </metadata>

    <imports>
        <artifact name="licenseWhitelist">Resources/license-whitelist.json</artifact>
        <artifact name="metadataExample">Samples/metadata-valid.jsonld</artifact>
        <artifact name="invalidMetadataExample">Samples/metadata-invalid.jsonld</artifact>
    </imports>

    <actors engineName="ITB Test Engine" engineDisplayOrder="4">
        <gitb:actor id="Provider" name="Energy Data Provider" role="SUT" displayOrder="0"/>
        <gitb:actor id="Authority" name="City Energy Data Space Authority" role="SIMULATED" displayOrder="1"/>
        <gitb:actor id="Validator" name="ITB Validation Engine" role="SIMULATED" displayOrder="2"/>
    </actors>

    <steps>
        <interact id="userData"
                  desc="Upload metadata for license policy validation">
            <request name="metadata"
                     desc="Select the JSON-LD metadata file that declares dct:license"
                     inputType="UPLOAD"
                     mimeType="application/ld+json"
                     required="true"/>
        </interact>

        <assign to="licenseStatusPriority">"untestable,fail,inapplicable,pass"</assign>
        <assign to="licenseField">"license"</assign>
        <assign to="licenseUploadedMetadata">$userData{metadata}</assign>
        <assign to="licenseValueSource">"Extract dct:license from uploaded metadata."</assign>
        <assign to="licensePassSample">$metadataExample</assign>
        <assign to="licensePassExpected">"pass"</assign>
        <assign to="licensePassDecision">"accepted"</assign>
        <assign to="licenseFailSample">$invalidMetadataExample</assign>
        <assign to="licenseFailExpected">"fail"</assign>
        <assign to="licenseFailDecision">"rejected"</assign>
        <assign to="licenseInapplicableExpected">"inapplicable"</assign>
        <assign to="licenseInapplicableDecision">"rejected"</assign>
        <assign to="licenseUntestableExpected">"untestable"</assign>
        <assign to="licenseUntestableDecision">"rejected"</assign>
    </steps>

    <output>
        <success>
            <default>"License policy validation logic is defined: pass is accepted; fail, inapplicable, and untestable are rejected."</default>
        </success>
        <failure>
            <default>"License policy validation scenario definition failed."</default>
        </failure>
    </output>

</testcase>
