<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  TC-4: License Compliance Verification
  ============================================================================
  目标: 验证数据产品的许可协议在 Data Space 允许的范围内

  检查:
    4.1 license 字段存在
    4.2 license 值为有效的 IRI
    4.3 license 在允许的开放许可白名单中

  白名单（City Energy Data Space 允许的许可）:
    ✅ https://creativecommons.org/licenses/by/4.0/       (CC-BY-4.0)
    ✅ https://creativecommons.org/licenses/by-sa/4.0/    (CC-BY-SA-4.0)
    ✅ https://creativecommons.org/publicdomain/zero/1.0/ (CC0)
    ❌ 任何不在白名单中的许可
    ❌ 空值或缺失

  测试类型: CONFORMANCE
  前置条件: TC-3 必须先通过（确保 API 可达，元数据可获取）
  ============================================================================
-->
<testcase id="urn:dssc:tc:license-compliance"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">

    <!-- ============================================================
         元数据
         ============================================================ -->
    <metadata>
        <gitb:name>TC-4: License Compliance Verification</gitb:name>
        <gitb:type>CONFORMANCE</gitb:type>
        <gitb:version>1.0</gitb:version>
        <gitb:description><![CDATA[
            验证数据产品的许可协议符合 Data Space 要求。

            在本项目中（演示用途），metadata 中声明的 license 为:
              https://creativecommons.org/licenses/by/4.0/ (CC-BY-4.0)

            验证逻辑:
              1. license 字段存在且非空
              2. license 是有效的 HTTP/HTTPS IRI
              3. license 在允许的白名单中

            白名单:
              - https://creativecommons.org/licenses/by/4.0/
              - https://creativecommons.org/licenses/by-sa/4.0/
              - https://creativecommons.org/publicdomain/zero/1.0/

            注意: 白名单应根据 Data Space Authority 的政策维护。
        ]]></gitb:description>
        <gitb:identifier>urn:dssc:tc:license-compliance</gitb:identifier>
    </metadata>

    <imports>
        <artifact name="ValidMetadata"
                  type="data"
                  encoding="UTF-8">
            artifacts/data-product-valid.jsonld
        </artifact>
    </imports>

    <actors>
        <gitb:actor id="Tester"
                    name="Test Operator"
                    role="SIMULATED"/>
    </actors>

    <variables>
        <var name="testStatus"       type="string">"PENDING"</var>
        <var name="licenseValue"     type="string">""</var>
        <var name="licenseIsValidIRI" type="boolean">false</var>
        <var name="licenseIsAllowed" type="boolean">false</var>
        <var name="detailReport"     type="string">""</var>

        <!--
          允许的许可白名单
          在实际 ITB 部署中，白名单可以配置在 artifact 文件或 environment 变量中
        -->
        <var name="ALLOWED_LICENSES" type="list">
            <item>"https://creativecommons.org/licenses/by/4.0/"</item>
            <item>"https://creativecommons.org/licenses/by-sa/4.0/"</item>
            <item>"https://creativecommons.org/publicdomain/zero/1.0/"</item>
        </var>
    </variables>

    <steps>

        <!-- Step 1: 提取 license 字段 -->
        <group desc="1. 从元数据中提取 license 字段">
            <interact id="metadataUpload"
                      desc="上传数据产品元数据以验证许可协议"
                      with="Tester">
                <input name="title">"上传元数据文件"</input>
                <input name="instruction"><![CDATA[
                    请上传数据产品元数据文件 (JSON-LD)。
                    系统将从中提取 license 字段并验证其合规性。

                    在本项目演示中，使用:
                      DSSC_Minimal_Energy_Scenario/metadata/data-product-valid.jsonld
                    (其 license = https://creativecommons.org/licenses/by/4.0/)
                ]]></input>
            </interact>

            <assign to="$metadata">$metadataUpload(content)</assign>

            <!-- 提取 license 值 -->
            <assign to="$licenseValue">
                $metadata(license)
            </assign>
        </group>

        <!-- Step 2: 检查 license 是否存在 -->
        <group desc="2. 检查 license 字段是否存在">
            <if>
                <cond>$licenseValue != null and $licenseValue != ""</cond>
                <then>
                    <assign to="$detailReport">
                        concat("✅ license 字段存在: ", $licenseValue, " | ")
                    </assign>
                </then>
                <else>
                    <assign to="$testStatus">"FAIL"</assign>
                    <assign to="$detailReport">
                        "❌ license 字段缺失或为空 — 所有数据产品必须声明许可协议 | "
                    </assign>
                    <exit/>
                </else>
            </if>
        </group>

        <!-- Step 3: 检查 license 是否为有效 IRI -->
        <group desc="3. 验证 license 是否为有效 IRI">
            <if>
                <cond>
                    starts-with($licenseValue, "https://")
                    or starts-with($licenseValue, "http://")
                </cond>
                <then>
                    <assign to="$licenseIsValidIRI">true</assign>
                    <assign to="$detailReport">
                        concat($detailReport, "✅ license 为有效 IRI | ")
                    </assign>
                </then>
                <else>
                    <assign to="$testStatus">"FAIL"</assign>
                    <assign to="$detailReport">
                        concat($detailReport, "❌ license 不是有效的 HTTP/HTTPS IRI: ",
                               $licenseValue, " | ")
                    </assign>
                    <exit/>
                </else>
            </if>
        </group>

        <!-- Step 4: 检查 license 是否在白名单中 -->
        <group desc="4. 验证 license 在允许的白名单中">
            <assign to="$licenseIsAllowed">false</assign>

            <!-- 遍历白名单 -->
            <forEach counter="i"
                     start="0"
                     end="count($ALLOWED_LICENSES) - 1">
                <do>
                    <if>
                        <cond>$licenseValue = $ALLOWED_LICENSES($i)</cond>
                        <then>
                            <assign to="$licenseIsAllowed">true</assign>
                        </then>
                    </if>
                </do>
            </forEach>

            <if>
                <cond>$licenseIsAllowed = true</cond>
                <then>
                    <assign to="$detailReport">
                        concat($detailReport, "✅ license 在允许的白名单中 | ")
                    </assign>
                </then>
                <else>
                    <assign to="$testStatus">"FAIL"</assign>
                    <assign to="$detailReport">
                        concat($detailReport, "❌ license '", $licenseValue,
                               "' 不在 Data Space 允许的白名单中。",
                               "允许的许可: CC-BY-4.0, CC-BY-SA-4.0, CC0 | ")
                    </assign>
                </else>
            </if>
        </group>

        <!-- Step 5: 最终判定 -->
        <group desc="5. 最终判定">
            <if>
                <cond>
                    $licenseIsValidIRI = true
                    and $licenseIsAllowed = true
                    and $testStatus != "FAIL"
                </cond>
                <then>
                    <assign to="$testStatus">"PASS"</assign>
                    <assign to="$detailReport">
                        concat($detailReport,
                               "✅ 许可协议合规 — ",
                               "数据产品使用 ", $licenseValue,
                               "，该许可在 City Energy Data Space 允许列表中。",
                               "消费者可在该许可条款下自由使用数据。")
                    </assign>
                </then>
                <else>
                    <assign to="$testStatus">"FAIL"</assign>
                </else>
            </if>
        </group>

    </steps>

</testcase>
