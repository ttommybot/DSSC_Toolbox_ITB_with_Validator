<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  TC-2: SHACL Invalid Metadata Detection
  ============================================================================
  目标: 验证 SHACL 规则引擎能正确检测违规 — 错误元数据应被拒绝并报告 3 个错误

  输入:
    - Shapes Graph : building-energy-shapes.ttl (9 条 SHACL 约束)
    - Data Graph   : data-product-invalid.jsonld (包含 3 个故意错误)

  预期结果:
    - sh:conforms = false
    - 3 个 ValidationResult:
        错误1: ex:providerName — MinCountConstraintComponent — 字段缺失
        错误2: ex:unit          — HasValueConstraintComponent — 值为 MWh，应为 kWh
        错误3: ex:temporalEnd   — MinCountConstraintComponent — 字段缺失

  测试类型: CONFORMANCE (Standalone Document Validation)
  前置条件: TC-1 必须先通过（确保 SHACL 引擎和规则文件本身没问题）
  ============================================================================
-->
<testcase id="urn:dssc:tc:shacl-invalid-metadata"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">

    <!-- ============================================================
         元数据
         ============================================================ -->
    <metadata>
        <gitb:name>TC-2: SHACL Invalid Metadata Detection</gitb:name>
        <gitb:type>CONFORMANCE</gitb:type>
        <gitb:version>1.0</gitb:version>
        <gitb:description><![CDATA[
            使用 data-product-invalid.jsonld（包含 3 个故意错误的元数据）
            验证 SHACL 规则引擎能正确检测并报告所有违规。

            非法元数据的 3 个错误:

            ┌────────┬──────────────────┬──────────────────────────────┬─────────────────────────────┐
            │ 错误 # │ sh:resultPath    │ 问题                         │ sh:sourceConstraintComponent│
            ├────────┼──────────────────┼──────────────────────────────┼─────────────────────────────┤
            │   1    │ ex:providerName  │ 字段完全缺失                  │ sh:MinCountConstraintComp… │
            │        │                  │ 规则要求: sh:minCount 1       │                             │
            ├────────┼──────────────────┼──────────────────────────────┼─────────────────────────────┤
            │   2    │ ex:unit          │ 值为 "MWh"，规则要求 "kWh"    │ sh:HasValueConstraintComp… │
            │        │                  │ 规则要求: sh:hasValue "kWh"   │                             │
            ├────────┼──────────────────┼──────────────────────────────┼─────────────────────────────┤
            │   3    │ ex:temporalEnd   │ 字段缺失，只有 temporalStart  │ sh:MinCountConstraintComp… │
            │        │                  │ 规则要求: sh:minCount 1       │                             │
            └────────┴──────────────────┴──────────────────────────────┴─────────────────────────────┘

            教学意义: 这三个错误分别覆盖了 3 类典型问题——
              错误1: 必填字段缺失      (对应 sh:minCount 约束)
              错误2: 枚举/值不符合     (对应 sh:hasValue 约束)
              错误3: 时间范围不完整    (对应 sh:minCount 约束在 pair field 上的应用)
        ]]></gitb:description>
        <gitb:identifier>urn:dssc:tc:shacl-invalid-metadata</gitb:identifier>
    </metadata>

    <!-- ============================================================
         命名空间
         ============================================================ -->
    <namespaces>
        <ns prefix="sh"   uri="http://www.w3.org/ns/shacl#"/>
        <ns prefix="ex"   uri="https://example.org/dssc-energy#"/>
        <ns prefix="xsd"  uri="http://www.w3.org/2001/XMLSchema#"/>
    </namespaces>

    <!-- ============================================================
         导入
         ============================================================ -->
    <imports>
        <artifact name="ShapeFile"
                  type="schema"
                  encoding="UTF-8">
            artifacts/building-energy-shapes.ttl
        </artifact>
        <artifact name="InvalidMetadata"
                  type="data"
                  encoding="UTF-8">
            artifacts/data-product-invalid.jsonld
        </artifact>
        <module name="SHACLValidator"
                uri="urn:com:gitb:validation:SHACLValidator"/>
    </imports>

    <!-- ============================================================
         Actor
         ============================================================ -->
    <actors>
        <gitb:actor id="Tester"
                    name="Test Operator"
                    role="SIMULATED"/>
        <gitb:actor id="Validator"
                    name="SHACL Validation Engine"
                    role="SIMULATED"/>
    </actors>

    <!-- ============================================================
         变量
         ============================================================ -->
    <variables>
        <var name="testStatus"          type="string">"PENDING"</var>
        <var name="shaclConforms"       type="boolean">true</var>
        <var name="errorCount"          type="number">0</var>
        <var name="expectedErrorCount"  type="number">3</var>
        <var name="detectedErrors"      type="list"/>
        <var name="error1_providerName" type="boolean">false</var>
        <var name="error2_unit"         type="boolean">false</var>
        <var name="error3_temporalEnd"  type="boolean">false</var>
        <var name="resultSummary"       type="string">""</var>
    </variables>

    <!-- ============================================================
         测试步骤
         ============================================================ -->
    <steps>

        <!-- Step 1: 上传非法元数据 -->
        <group desc="1. 上传待验证的非法元数据文件">
            <interact id="metadataUpload"
                      desc="请上传 data-product-invalid.jsonld（包含 3 个故意错误的元数据）"
                      with="Tester">
                <input name="title">"上传非法建筑能耗数据产品元数据"</input>
                <input name="instruction"><![CDATA[
                    请选择文件: DSSC_Minimal_Energy_Scenario/metadata/data-product-invalid.jsonld

                    此文件故意包含 3 个错误:
                      ❌ providerName 缺失
                      ❌ unit = "MWh"（规则要求 "kWh"）
                      ❌ temporalEnd 缺失

                    预期: SHACL 验证器应报告 sh:conforms = false，并列出 3 个违规。
                ]]></input>
            </interact>

            <assign to="$metadataContent">
                $metadataUpload(content)
            </assign>
        </group>

        <!-- Step 2: 执行 SHACL 验证 -->
        <group desc="2. 执行 SHACL 约束验证">
            <verify handler="SHACLValidator"
                    id="shaclCheck"
                    desc="调用 SEMIC SHACL Validator — 预期返回 3 个违规">
                <input name="dataGraph">$metadataContent</input>
                <input name="shapesGraph" source="$ShapeFile"/>
            </verify>

            <assign to="$shaclConforms">$shaclCheck</assign>
        </group>

        <!-- Step 3: 判定结果 — 核心逻辑 -->
        <group desc="3. 判定验证结果">
            <!--
              条件: 验证必须失败 (sh:conforms = false)
              如果通过了，说明 SHACL 规则有 bug — 这是异常情况！
            -->
            <if>
                <cond>$shaclConforms = false</cond>
                <then>
                    <!-- 正确行为: 验证失败 -->
                    <assign to="$testStatus">"PASS"</assign>
                    <!--
                      注意这里的逻辑:
                        testStatus = "PASS" 表示 "这个 Test Case 本身通过了"
                        意思是: 系统正确地检测到了非法元数据存在的问题

                        业务层面的 PASS 含义:
                          数据提供方提交了错误的元数据 → SHACL 验证器成功拦截 → 系统行为正确
                    -->
                    <assign to="$resultSummary"><![CDATA[
                        测试通过 — SHACL 验证器正确拒绝了非法元数据。
                        数据产品的元数据未通过语义模型验证，
                        提供方需要修改以下问题后才能继续入驻流程。
                    ]]></assign>
                </then>
                <else>
                    <!--
                      异常: 非法元数据居然通过了 — SHACL 规则可能有问题
                    -->
                    <assign to="$testStatus">"FAIL"</assign>
                    <assign to="$resultSummary"><![CDATA[
                        测试失败！data-product-invalid.jsonld 包含 3 个故意错误，
                        但 SHACL 验证器返回了 sh:conforms = true。
                        可能原因: SHACL 规则文件损坏、验证器配置错误、或规则未正确加载。
                    ]]></assign>
                </else>
            </if>
        </group>

        <!-- Step 4: 检查 3 个具体错误是否都被检测到 -->
        <group desc="4. 验证 3 个具体错误是否均被检测">
            <!--
              检查 SHACL 返回的 ValidationReport 中是否包含预期的 3 个错误路径:
                - ex:providerName
                - ex:unit
                - ex:temporalEnd
            -->
            <assign to="$validationResults">
                $shaclCheck(report)
            </assign>

            <!-- 检查错误1: providerName -->
            <verify handler="XPathValidator"
                    id="hasProviderNameError"
                    desc="检查是否包含 providerName 缺失错误">
                <input name="xmldocument">$validationResults</input>
                <input name="xpath"><![CDATA[
                    count(//sh:result[sh:resultPath/@value = 'ex:providerName'])
                ]]></input>
            </verify>

            <!-- 检查错误2: unit -->
            <verify handler="XPathValidator"
                    id="hasUnitError"
                    desc="检查是否包含 unit 值错误 (MWh 应为 kWh)">
                <input name="xmldocument">$validationResults</input>
                <input name="xpath"><![CDATA[
                    count(//sh:result[sh:resultPath/@value = 'ex:unit'])
                ]]></input>
            </verify>

            <!-- 检查错误3: temporalEnd -->
            <verify handler="XPathValidator"
                    id="hasTemporalEndError"
                    desc="检查是否包含 temporalEnd 缺失错误">
                <input name="xmldocument">$validationResults</input>
                <input name="xpath"><![CDATA[
                    count(//sh:result[sh:resultPath/@value = 'ex:temporalEnd'])
                ]]></input>
            </verify>

            <!-- 最终整体判定: 必须检测到恰好 3 个错误 且 testStatus = PASS -->
            <if>
                <cond>
                    $hasProviderNameError = true
                    and $hasUnitError = true
                    and $hasTemporalEndError = true
                    and $testStatus = "PASS"
                </cond>
                <then>
                    <assign to="$resultSummary"><![CDATA[
                        ✅ 全部通过 — 3 个预期错误均被正确检测。

                        错误详情:
                          1. ❌ ex:providerName — MinCountViolation — "providerName is required for data space onboarding."
                          2. ❌ ex:unit          — HasValueViolation  — "unit must be kWh." (提交值: "MWh")
                          3. ❌ ex:temporalEnd   — MinCountViolation — "temporalEnd is required and must be an xsd:date."

                        错误类型覆盖:
                          · 必填字段缺失  (MinCountConstraintComponent)      × 2
                          · 枚举值不符合  (HasValueConstraintComponent)       × 1
                          · 日期范围不完整 (MinCount on temporalEnd)          × 1
                    ]]></assign>
                </then>
                <else>
                    <assign to="$testStatus">"FAIL"</assign>
                    <assign to="$resultSummary">
                        concat("部分错误未被检测。预期 3 个错误，实际: providerName=",
                               $hasProviderNameError, ", unit=", $hasUnitError,
                               ", temporalEnd=", $hasTemporalEndError)
                    </assign>
                </else>
            </if>
        </group>

    </steps>

</testcase>
